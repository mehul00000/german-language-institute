# Copy to .env.local and fill in. Never commit .env.local.

# Clerk (admin authentication). Without these the site runs keyless
# and the dashboard says so plainly.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# Convex (database and backend). Run `npx convex dev` once to create
# the deployment, which sets CONVEX_DEPLOYMENT; copy the URL here.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# The canonical site origin, used for SEO metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional email notifications (Resend).
RESEND_API_KEY=
